   "source": [
    "def add_patient_data(name, age):\n",
    "    if type(name) is not str or type(age) is not int:\n",
    "        raise ValueError(\"Invalid data types for name or age.\")\n",
    "    print(f\"Adding patient data: Name - {name}, Age - {age}\")"
   ]
  },
